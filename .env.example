# Secret key for session encryption
SECRET_KEY=a_very_secret_key_for_sessions

# Database URI
# Default (SQLite - zero setup needed):
DATABASE_URL=sqlite:///resume_builder.db
# MySQL example:
# DATABASE_URL=mysql+mysqlconnector://root:root@localhost/resume_builder_db

# Groq AI API Key for ATS Resume Generation (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# (Optional) SMTP Email Settings for Password Reset Delivery
# If left blank, password reset links will be printed in the terminal for local testing!
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
